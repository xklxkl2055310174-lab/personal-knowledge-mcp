MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_KNOWLEDGE_ROOT=./knowledge
MCP_WORKSPACE_ROOT=./workspace
MCP_REPOSITORY_ROOT=.
MCP_RUNTIME_ROOT=./.runtime
MCP_ALLOWED_COMMANDS=python,python3,pytest,git,rg
MCP_COMMAND_TIMEOUT_SECONDS=10
MCP_COMMAND_OUTPUT_BYTES=20000
MCP_MAX_FILE_BYTES=1000000
MCP_SANDBOX=local
MCP_SANDBOX_IMAGE=python:3.12-slim
